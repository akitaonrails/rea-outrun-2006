#!/bin/sh
# Plays OutRun 2006: Coast 2 Coast on Linux through Wine and gamescope.
#
#   or-play           show the settings window, then start the game
#   or-play --play    start the game with the saved settings (no window);
#                     launcher options follow, e.g. --play --scaler fsr
#   or-play stop      end the game session or-play started, and its Wine
#   or-play status    running or idle
#
# The settings window is OutRunLauncher.exe's own (the same as on Windows),
# shown through Wine before gamescope starts. Settings live in launcher.cfg
# inside the Wine prefix, the gamescope scaler included.
#
# Optional environment:
#   OR_PREFIX    Wine prefix       (default ~/.local/share/or-launcher/prefix)
#   OR_LAUNCHER  OutRunLauncher.exe   (default: next to this script, or one folder up)
#   OR_RUN       a wrapper that runs wine and gamescope, e.g.
#                 "distrobox enter gaming --" when they live in a container
#
# The session, the GPU choice, gamescope and the prefix are the shared
# rea-play.sh library's (rea-launcher-sdk); this script holds OutRun's
# choices.
set -u

# The library: next to this script in a package, else the vendored copy.
# Tests source this script with REA_FUNCTIONS_ONLY=1 (load, don't run) and
# REA_PLAY_HERE=<this script's folder> ($0 is then the test); REA_PLAY_HERE
# counts only in that mode, and the library drops both once sourced.
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=or-play

REA_APP=or-launcher                   # ~/.config/or-launcher, the prefix name
REA_EXE_NAME=OutRunLauncher.exe
REA_EXE_HINT=OR_LAUNCHER
REA_EXE=${OR_LAUNCHER:-}
REA_PREFIX=${OR_PREFIX:-}
REA_RUN=${OR_RUN:-}
REA_WAIT=${OR_WAIT:-}                 # set by the AppImage; every launch waits
REA_CFG_APPDATA=OutRunLauncher        # AppData\Local\OutRunLauncher\launcher.cfg
# "original" or "off" is the game's own 640x480 (the launcher reads both
# that way), and so is an unset or unreadable resolution with no look.
REA_ORIGINAL_SIZE=640x480
REA_ORIGINAL_WORDS="original off"
REA_DEFAULT_SIZE=640x480
# A lock from or-play 0.1.0 held or-play's own pid: it counts as running,
# but stop never signals it.
REA_LEGACY_LOCK=keep
# The game has no windowed mode on the desktop (a borderless window of the
# race size at 0,0, or exclusive fullscreen), so it always goes in
# gamescope when there is one (no REA_WINDOWED_KEY). The launcher waits for
# the game and copies the saves back before it exits, so waiting for it is
# waiting for the game (no REA_GAME_PROCS: watching the game's process
# raced Wine's start-up and killed the launcher).

# `or-play --play --scaler fsr --resolution 1280x720`: the flags still go
# to the launcher, and for that run the helper reads them over
# launcher.cfg (gamescope's filter and size); the file is not written.
REA_HELPER_KEYS="scaler resolution look"

# The race size a look gives (form::look_settings): Steam Deck 1280x800,
# Coast to Coast the screen (the launcher inside sees gamescope's screen),
# Original the game's 640x480.
or_look_size() {
  case $1 in
    steam_deck) echo 1280x800 ;;
    coast_to_coast) rea_screen_size || echo 1920x1080 ;;
    original) echo 640x480 ;;
    *) return 1 ;;
  esac
}

# As Settings::combine: launcher.cfg's look fills the resolution the file
# leaves unset; a --look for this run wins over the file's resolution; a
# --resolution wins over both. The size goes into this run's values, which
# rea_game_size reads first.
rea_hook_before_start() {
  [ -n "$(REA_CFG=; rea_get_key resolution)" ] && return 0
  _or_size=
  _or_look=$(REA_CFG=; rea_get_value look)
  if [ -n "$_or_look" ]; then
    _or_size=$(or_look_size "$_or_look") || _or_size=
  elif [ -n "$REA_CFG" ] && [ -z "$(rea_get_key resolution "$REA_CFG")" ]; then
    _or_look=$(rea_get_value look "$REA_CFG")
    [ -n "$_or_look" ] && { _or_size=$(or_look_size "$_or_look") || _or_size=; }
  fi
  [ -n "$_or_size" ] || return 0
  REA_ONE_RUN="${REA_ONE_RUN:+$REA_ONE_RUN
}resolution=$_or_size"
}
REA_FLAG_SWITCHES="--no-window --settings --linux --check --download-hd-pack --help"

rea_init || exit 1
# Tests load the configuration without running anything.
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
