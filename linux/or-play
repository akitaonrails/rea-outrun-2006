#!/bin/sh
# Plays OutRun 2006: Coast 2 Coast on Linux through Wine and gamescope.
#
#   or-play           show the settings window, then start the game
#   or-play --play    start the game with the saved settings (no window)
#   or-play stop      end the game session or-play started, and its Wine
#   or-play status    running or idle
#
# The settings window is OutRunLauncher.exe's own (the same as on Windows),
# shown through Wine before gamescope starts. Settings live in launcher.cfg
# inside the Wine prefix, the gamescope scaler included.
#
# Optional environment:
#   OR_PREFIX    Wine prefix       (default ~/.local/share/or-launcher/prefix)
#   OR_LAUNCHER  OutRunLauncher.exe   (default: next to this script, or one folder up)
#   OR_RUN       a wrapper that runs wine and gamescope, e.g.
#                 "distrobox enter gaming --" when they live in a container
set -u
HERE=$(dirname "$(readlink -f "$0")")
PREFIX=${OR_PREFIX:-$HOME/.local/share/or-launcher/prefix}
LAUNCHER=${OR_LAUNCHER:-}
if [ -z "$LAUNCHER" ]; then
  for p in "$HERE/OutRunLauncher.exe" "$HERE/../OutRunLauncher.exe"; do
    [ -f "$p" ] && LAUNCHER=$(readlink -f "$p") && break
  done
fi
RUN=${OR_RUN:-}
STATE=$HOME/.config/or-launcher
mkdir -p "$STATE" "$PREFIX"

# launcher.cfg is in the prefix user's AppData\Local\OutRunLauncher.
CFG=
for d in "$PREFIX"/drive_c/users/*/AppData/Local/OutRunLauncher; do
  case "$d" in */users/Public/*|*'*'*) continue ;; esac
  [ -d "$d" ] && CFG=$d/launcher.cfg
done
[ -z "$CFG" ] && CFG=$PREFIX/drive_c/users/$USER/AppData/Local/OutRunLauncher/launcher.cfg

get_key() { [ -f "$CFG" ] && sed -n "s|^$1 *= *||p" "$CFG" | tail -1; }
LOCK=$STATE/running.pid

# Prints a process's session id and start time from /proc. The fields after
# the last ") " are used, so a command name with spaces or parentheses
# can't shift them.
proc_stat() {
  [ -r "/proc/$1/stat" ] || return 1
  stat=$(cat "/proc/$1/stat") || return 1
  rest=${stat##*) }
  set -- $rest
  [ "$#" -ge 20 ] || return 1
  printf '%s %s\n' "$4" "${20}"
}

read_lock() {
  [ -r "$LOCK" ] || return 1
  IFS=' ' read -r LOCK_PID LOCK_START < "$LOCK" || return 1
  case "$LOCK_PID" in ''|*[!0-9]*) return 1 ;; esac
  case "$LOCK_START" in ''|*[!0-9]*) return 1 ;; esac
}

# The lock holds the pid and start time of the session or-play started. It
# counts only while that pid is still the leader of its own session with the
# same start time: a stale lock, or a pid reused by another program, doesn't.
session_valid() {
  read_lock || return 1
  stats=$(proc_stat "$LOCK_PID") || return 1
  [ "$stats" = "$LOCK_PID $LOCK_START" ]
}

# Running, or still starting (the launcher copies files before
# OR2006C2C.exe appears): the session or-play started is alive. Another
# OR2006C2C.exe (Steam's, say) is not ours and doesn't count.
running() { session_valid; }

# The best GPU for the game, as environment assignments (none: the
# default GPU). A player's own DRI_PRIME / __NV_PRIME_RENDER_OFFLOAD win.
# - NVIDIA with its driver and OpenGL library: NVIDIA's render offload,
#   which picks it over an integrated GPU (harmless when it drives the
#   screen anyway).
# - Several Mesa GPUs, the screen's one integrated (Intel, or less video
#   memory than another): DRI_PRIME=1, the other one.
# OR_SYSFS replaces /sys (tests).
gpu_env() {
  [ -n "${DRI_PRIME:-}${__NV_PRIME_RENDER_OFFLOAD:-}" ] && return
  sys=${OR_SYSFS:-/sys}
  n=0 nvidia= boot= boot_vram=0 other_vram=0
  for d in "$sys"/class/drm/card*; do
    case "${d##*/}" in *-*) continue ;; esac  # connectors (card0-DP-1)
    [ -r "$d/device/vendor" ] || continue
    n=$((n + 1))
    vram=$(cat "$d/device/mem_info_vram_total" 2>/dev/null || echo 0)
    [ "$(basename "$(readlink "$d/device/driver")")" = nvidia ] && nvidia=1
    if [ "$(cat "$d/device/boot_vga" 2>/dev/null)" = 1 ]; then
      boot=$(cat "$d/device/vendor"); boot_vram=$vram
    elif [ "$vram" -gt "$other_vram" ]; then
      other_vram=$vram
    fi
  done
  if [ -n "$nvidia" ] && $RUN sh -c 'ldconfig -p 2>/dev/null | grep -q libGLX_nvidia.so.0'; then
    echo "__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only"
  elif [ "$n" -ge 2 ] && { [ "$boot" = 0x8086 ] || [ "$other_vram" -gt "$boot_vram" ]; }; then
    echo "DRI_PRIME=1"
  fi
}

start() {
  if [ -z "$LAUNCHER" ] || [ ! -f "$LAUNCHER" ]; then
    echo "OutRunLauncher.exe not found next to or-play (or set OR_LAUNCHER)"; exit 1
  fi
  # No resolution saved: a 1080p screen. "original" is the game's own 640x480;
  # anything that is not WIDTHxHEIGHT falls back to 1080p too.
  res=$(get_key resolution | tr -d '\r \t' | tr 'A-Z' 'a-z'); W=1920; H=1080
  case $res in
    original) W=640; H=480 ;;
    *[!0-9x]*|x*|*x|*x*x*|"") ;;
    *x*) W=${res%x*}; H=${res#*x} ;;
  esac
  F=$(get_key scaler); F=${F:-linear}
  inner=$STATE/inner.sh
  # The launcher's path is the script's first argument, never part of its
  # source (a path with a quote in it can't break or inject into it).
  cat > "$inner" <<'INNER'
#!/bin/sh
trap 'wineserver -k; exit' INT TERM HUP
# The launcher waits for the game (and copies the saves back) before it
# exits, so waiting for it is waiting for the game. Watching for the game's
# process instead raced Wine's start-up and killed the launcher.
wine "$1" --no-window
wineserver -k
INNER
  chmod +x "$inner"
  # Already inside gamescope (a Steam Deck in Game Mode), or none installed:
  # the game runs directly (a second gamescope inside one fails). Otherwise
  # gamescope gives the game a landscape screen of the game's size and scales
  # it to the monitor, keeping its shape. The game has no windowed mode on
  # the desktop (a borderless window of the race size at 0,0, or exclusive
  # fullscreen), so it always goes in gamescope when there is one.
  if [ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" ] || ! $RUN sh -c "command -v gamescope" >/dev/null 2>&1; then
    echo "starting without a gamescope of our own"
    launch sh "$inner" "$LAUNCHER"
  else
    echo "starting at ${W}x${H}, scaler $F"
    launch gamescope -w "$W" -h "$H" -W "$W" -H "$H" -f -S fit -F "$F" -- "$inner" "$LAUNCHER"
  fi
}

# Interrupted while the game runs: end the session we started.
launch_interrupted() {
  trap - EXIT HUP INT TERM
  if session_valid; then
    kill -TERM "-$LOCK_PID" 2>/dev/null || true
  fi
  rm -f "$LOCK"
  exit 143
}

# Runs a command in the prefix, in a session of its own, and waits for it,
# so the game outlives nothing that started it (distrobox and the AppImage
# end their session, and everything in it, when or-play returns). The lock
# holds the session's pid and start time meanwhile, for `or-play stop` and
# `status`. OutRun2006Tweaks reads pads through SDL: SDL keeps reading them
# when the game's window isn't focused, unless the caller says otherwise.
launch() {
  sdl_pad_bg=${SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS:-1}
  sdl_joy_bg=${SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS:-1}
  setsid $RUN env WINEPREFIX="$PREFIX" \
    SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS="$sdl_pad_bg" \
    SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS="$sdl_joy_bg" \
    $GPU "$@" > "$STATE/play.log" 2>&1 < /dev/null &
  pid=$!
  stats=$(proc_stat "$pid") || {
    wait "$pid"
    return "$?"
  }
  printf '%s %s\n' "$pid" "${stats#* }" > "$LOCK"
  trap 'rm -f "$LOCK"' EXIT
  trap 'launch_interrupted' HUP INT TERM
  wait "$pid"
  rc=$?
  rm -f "$LOCK"
  trap - EXIT HUP INT TERM
  return "$rc"
}

# Ends the session or-play started (checked again right before the signal:
# a stale or reused pid, or another OR2006C2C.exe, is never a target), then
# whatever is left in our own Wine prefix.
stop_session() {
  if session_valid; then
    kill -TERM "-$LOCK_PID" 2>/dev/null || true
  fi
  rm -f "$LOCK"
  $RUN env WINEPREFIX="$PREFIX" wineserver -k 2>/dev/null
  return 0
}

# The settings window; its exit code says what to do next.
settings() {
  $RUN env WINEPREFIX="$PREFIX" \
    SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS="${SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS:-1}" \
    SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS="${SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS:-1}" \
    $GPU wine "$LAUNCHER" --settings --linux 2>/dev/null
  rc=$?
  # The window ran on the desktop. Its wineserver lingers for a few seconds
  # and is tied to the desktop's display; a game started meanwhile would
  # join it and open there instead of in gamescope. Wait for it to end.
  $RUN env WINEPREFIX="$PREFIX" wineserver -w 2>/dev/null
  case $rc in
    0|4) return 0 ;;  # Play pressed, or no window could be shown
    *) return 1 ;;    # closed
  esac
}

# Tests load the functions above without running anything.
[ -n "${OR_PLAY_FUNCTIONS_ONLY:-}" ] && return 0
GPU=$(gpu_env)
[ -n "$GPU" ] && echo "GPU: $GPU"

case "${1:-}" in
  "")
    if running; then echo "already running"; exit 0; fi
    if [ -z "$LAUNCHER" ] || [ ! -f "$LAUNCHER" ]; then
      echo "OutRunLauncher.exe not found next to or-play (or set OR_LAUNCHER)"; exit 1
    fi
    settings || exit 0
    start ;;
  --play|start)
    if running; then echo "already running"; else start; fi ;;
  status) if running; then echo running; else echo idle; fi ;;
  stop)
    stop_session
    echo stopped ;;
  *) echo "usage: $0 [--play|stop|status]"; exit 2 ;;
esac
